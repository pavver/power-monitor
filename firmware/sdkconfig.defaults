CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# 1 ms ticks: the sensor samples the optocoupler once per millisecond.
CONFIG_FREERTOS_HZ=1000
# Phones send long headers to captive portals.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
# The partition table (partitions.csv) is written by espflash, see .cargo/config.toml.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# A new OTA image that crashes before confirming itself is rolled back.
# Needs the bootloader built here, see flash.sh (--bootloader).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Web server (7 connections + 2 internal), captive DNS and Telegram TLS
# together exceed the default of 10 sockets.
CONFIG_LWIP_MAX_SOCKETS=16
