CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# 1 ms ticks: the sensor samples the optocoupler once per millisecond.
CONFIG_FREERTOS_HZ=1000
# Phones send long headers to captive portals.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
# The partition table (partitions.csv) is written by espflash, see .cargo/config.toml.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# A new OTA image that crashes before confirming itself is rolled back.
# Needs the bootloader built here, see flash.sh (--bootloader).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Web server (7 connections + 2 internal), captive DNS and Telegram TLS
# together exceed the default of 10 sockets.
CONFIG_LWIP_MAX_SOCKETS=16
# Bluetooth LE to read a JK BMS: NimBLE (lighter than Bluedroid), as a
# central with one connection; the classic Bluetooth controller is left out.
# The peripheral role stays in for its GATT server: a JK BMS asks the client
# about its services, and with no answer it stops notifying after the 30 s
# ATT timeout while the link stays up.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# TLS buffers only while a record is in flight, and the CA and config data
# freed after the handshake: the remote session and Telegram each hold a TLS
# connection, and with fixed 16 KB buffers the two did not fit side by side.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# Fewer Wi-Fi receive buffers kept from the start (default 10 of 1.6 KB):
# with Bluetooth on, a Telegram TLS handshake did not find room.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=5
